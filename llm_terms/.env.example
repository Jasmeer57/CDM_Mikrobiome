# CDM Pipeline Environment Configuration
# Copy this file to .env and update the values

# LLM Configuration
DEFAULT_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
BIOMISTRAL_MODEL=biomistral-7B

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO

# Database Configuration (Optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdm_pipeline
POSTGRES_USER=cdm_user
POSTGRES_PASSWORD=REDACTED_PASSWORD

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Biomedical APIs (Optional)
UMLS_API_KEY=your_umls_api_key_here
ATHENA_API_URL=http://api.ohdsi.org/WebAPI

# Pipeline Configuration
MIN_CONFIDENCE=0.6
SEMANTIC_THRESHOLD=0.8
MAX_WORKERS=3
MAX_ENTITIES=200

# Feature Flags
ENABLE_BIOMISTRAL=false
ENABLE_OMOP_MAPPING=false
ENABLE_UMLS_MAPPING=false
ENABLE_COMPREHENSIVE_MAPPING=false

# Security
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Monitoring (Optional)
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
JAEGER_ENABLED=false

# Development
DEBUG=false
RELOAD=false