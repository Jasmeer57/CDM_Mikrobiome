initials="RC">Regina C</given-names></name><xref ref-type="aff" rid="AF0007">7</xref><xref ref-type="aff" rid="AF0008">8</xref><xref ref-type="author-notes" rid="fn-0002"/></contrib></contrib-group><aff id="AF0001"><label>1</label>Program in Computational Biology and Bioinformatics, Duke University, Durham, North Carolina</aff><aff id="AF0002"><label>2</label>Center for Genomic and Computational Biology, Duke University, Durham, North Carolina</aff><aff id="AF0003"><label>3</label>Department of Molecular Genetics and Microbiology, Duke University, Durham, North Carolina</aff><aff id="AF0004"><label>4</label>Department of Biology, Duke University, Durham, North Carolina</aff><aff id="AF0005"><label>5</label>Department of Biomedical Engineering, Duke University, Durham, North Carolina</aff><aff id="AF0006"><label>6</label>Medical Scientist Training Program, Duke University, Durham, North Carolina</aff><aff id="AF0007"><label>7</label>Division of Infectious Diseases, Massachusetts General Hospital, Boston, Massachusetts</aff><aff id="AF0008"><label>8</label>Department of Medicine, Harvard Medical School, Boston, Massachusetts</aff><aff id="AF0009"><label>9</label>Department of Microbiology and Immunobiology, Harvard Medical School, Boston, Massachusetts</aff><aff id="AF0010"><label>10</label>Department of Pediatrics, Harvard Medical School, Boston, Massachusetts</aff><aff id="AF0011"><label>11</label>Department of Immunology and Infectious Diseases, Harvard School of Public Health, Boston, Massachusetts</aff><aff id="AF0012"><label>12</label>Mucosal Immunology and Vaccinology Laboratory, Infectious Diseases Division, International Centre for Diarrhoeal Disease Research, Bangladesh, Dhaka</aff><aff id="AF0013"><label>13</label>Massachusetts College of Pharmacy and Health Sciences University, Boston</aff><author-notes><fn id="fn-0001"><p>F. S. M. and A. A. W. are joint first authors.</p></fn><fn id="fn-0002"><p>L. A. D. and R. C. L. are joint last authors.</p></fn><corresp id="c1">Correspondence: L. A. David, PhD, Department of Molecular Genetics and Microbiology, Duke University, Box 3382, 101 Science Dr, Durham, NC 27708 (<email>lawrence.david@duke.edu</email>).</corresp></author-notes><pub-date pub-type="ppub"><day>15</day><month>8</month><year>2018</year></pub-date><pub-date pub-type="epub" iso-8601-date="2018-04-12"><day>12</day><month>4</month><year>2018</year></pub-date><volume>218</volume><issue>4</issue><issue-id pub-id-type="pmc-issue-id">317052</issue-id><fpage>645</fpage><lpage>653</lpage><history><date date-type="received"><day>25</day><month>9</month><year>2017</year></date><date date-type="accepted"><day>10</day><month>4</month><year>2018</year></date></history><pub-history><event event-type="pmc-release"><date><day>13</day><month>07</month><year>2019</year></date></event><event event-type="pmc-live"><date><day>13</day><month>07</month><year>2019</year></date></event><event event-type="pmc-released-under-embargo"><date><day>20</day><month>07</month><year>2018</year></date></event><event event-type="pmc-last-change"><date iso-8601-date="2023-08-19 19:25:19.447"><day>19</day><month>08</month><year>2023</year></date></event></pub-history><permissions><copyright-statement>© The Author(s) 2018. Published by Oxford University Press for the Infectious Diseases Society of America. All rights reserved. For permissions, e-mail: journals.permissions@oup.com.</copyright-statement><copyright-year>2018</copyright-year><license xmlns:xlink="http://www.w3.org/1999/xlink" license-type="oup-standard" xlink:href="https://academic.oup.com/journals/pages/open_access/funder_policies/chorus/standard_publication_model"><license-p>This article is published and distributed under the terms of the Oxford University Press, Standard Journals Publication Model (<ext-link ext-link-type="uri" xlink:href="https://academic.oup.com/journals/pages/open_access/funder_policies/chorus/standard_publication_model">https://academic.oup.com/journals/pages/open_access/funder_policies/chorus/standard_publication_model</ext-link>)</license-p></license></permissions><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" content-type="pmc-pdf" xlink:href="jiy192.pdf"/><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="jiy192.pdf"/><abstract abstract-type="teaser"><p>A machine-learning algorithm identified signatures of human gut microbial communities that predicted susceptibility to cholera in a high-risk population in Bangladesh.</p></abstract><abstract><title>Abstract</title><sec id="s1"><title>Background</title><p>Cholera is a public health problem worldwide, and the risk factors for infection are only partially understood.</p></sec><sec id="s2"><title>Methods</title><p>We prospectively studied household contacts of patients with cholera to compare those who were infected to those who were not. We constructed predictive machine learning models of susceptibility, using baseline gut microbiota data. We identified bacterial taxa associated with susceptibility to <italic toggle="yes">Vibrio cholerae</italic> infection and tested these taxa for interactions with <italic toggle="yes">V. cholerae</italic> in vitro.</p></sec><sec id="s3"><title>Results</title><p>We found that machine learning models based on gut microbiota, as well as models based on known clinical and epidemiological risk factors, predicted <italic toggle="yes">V. cholerae</italic> infection. A predictive gut microbiota of roughly 100 bacterial taxa discriminated between contacts who developed infection and those who did not. Susceptibility to cholera was associated with depleted levels of microbes from the phylum Bacteroidetes. By contrast, a microbe associated with cholera by our modeling framework, <italic toggle="yes">Paracoccus aminovorans</italic>, promoted the in vitro growth of <italic toggle="yes">V. cholerae</italic>. Gut microbiota structure, clinical outcome, and age were also linked.</p></sec><sec id="s4"><title>Conclusion</title><p>These findings support the hypothesis that abnormal gut microbial communities are a host factor related to <italic toggle="yes">V. cholerae</italic> susceptibility.</p></sec></abstract><kwd-group><kwd><italic toggle="yes">Vibrio cholerae</italic></kwd><kwd>microbiome</kwd><kwd>machine learning</kwd></kwd-group><funding-group><award-group award-type="grant"><funding-source><named-content content-type="funder-name">National Institute of Allergy and Infectious Diseases</named-content><named-content content-type="funder-identifier">10.13039/100000060</named-content></funding-source></award-group><award-group award-type="grant"><funding-source><named-content content-type="funder-name">National Institutes of Health</named-content><named-content content-type="funder-identifier">10.13039/100000002</named-content></funding-source><award-id>R01AI103055</award-id><award-id>U01AI0589354</award-id><award-id>T32A1070611976</award-id><award-id>K08AI123494</award-id><award-id>T32GM071340</award-id><award-id>T32GM007171</award-id></award-group><award-group award-type="grant"><funding-source><named-content content-type="funder-name">National Institute of General Medical Sciences</named-content><named-content content-type="funder-identifier">10.13039/100000057</named-content></funding-source><award-id>T32GM071340</award-id><award-id>T32GM007171</award-id></award-group><award-group award-type="grant"><funding-source><named-content content-type="funder-name">National Science Foundation</named-content><named-content content-type="funder-identifier">10.13039/100000001</named-content></funding-source><award-id>DGE-1545220</award-id><award-id>DGE-1106401</award-id><award-id>2016-IDG-1013</award-id></award-group><award-group award-type="grant"><funding-source><named-content content-type="funder-name">Alfred P. Sloan Foundation</named-content><named-content content-type="funder-identifier">10.13039/100000879</named-content></funding-source></award-group><award-group award-type="grant"><funding-sou