          <rdf:li xml:lang="x-repair">Research Article</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>gut microbiome</rdf:li>
          <rdf:li>intensive care unit</rdf:li>
