# --- Qwen-primary experimental build (2026-10; NOT a release) ---
# The Qwen DB/OWL/TTL are an experimental filtered projection of the
# canonical tracked microbiome_cdm.db (see paper_claims/build_qwen_cdm.py).
# They were archived on 2026-10-03 after the release-audit found that the
# Qwen-derived manifest didn't match the tracked-DB-derived catalogue.
# See docs/RELEASE_AUDIT_2026-10-03.md §M for the rationale.
/archive/qwen_experiment_2026_10_02/microbiome_cdm_qwen.db
/archive/qwen_experiment_2026_10_02/microbiome_cdm_qwen.owl
/archive/qwen_experiment_2026_10_02/microbiome_cdm_qwen.ttl
/archive/qwen_experiment_2026_10_02/microbiome_cdm_qwen_only.db
# Future Qwen-style experiments land here too.
/archive/qwen_experiment_*/

