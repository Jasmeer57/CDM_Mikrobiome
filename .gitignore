segmented_sections_markdown/

# --- Secrets (P0.2 audit, 2026-10-26) ---
# corpus_v2/config/secrets.env was not matched by .env or .env.* ;
# these patterns close that gap. No .git/ exists yet, so this has no
# immediate effect; it prevents a future 'git add' from staging secrets.
secrets.env
**/secrets.env
*.key
*.pem

# --- Publication phase (2026-11-03) ---
# Secrets: the LLM-judge key lives in ~/.fhgenie_secrets.yml (outside the repo); never let a copy in.
*secrets*.yml
*secrets*.yaml
.fhgenie*
# Scratch files of other agents / audit runs at the repo root.
/.sbx_*
/.audit_tmp/
# Release payloads are published through Zenodo, not git: several files exceed 100 MB, and
# frozen bundles contain section text and term contexts of the 179 papers whose licence does
# not allow redistribution (paper/publication/rights/). Keep only docs, ledgers and checksums.
/releases/**/*
!/releases/**/
!/releases/RELEASES.md
!/releases/ZENODO_UPLOAD_METADATA.json
!/releases/**/README.md
!/releases/**/*.sha256
!/releases/CURRENT_FROZEN_SET_2026-11-02/*
# Authors' copy of all paper outputs (collect_frozen_outputs.py): same rights rule, keep only the index files.
/paper/publication/all_frozen_outputs/**/*
!/paper/publication/all_frozen_outputs/**/
!/paper/publication/all_frozen_outputs/README.md
!/paper/publication/all_frozen_outputs/INVENTORY.tsv
!/paper/publication/all_frozen_outputs/MANIFEST.sha256
# Faulty first deposit build, kept only until the user deletes it.
/releases/zenodo_frozen_build1_SUPERSEDED/
# paper_claims/ was renamed paper/: same generated-data exclusions under the new path.
/paper/_multi_ner_runs/*
!/paper/_multi_ner_runs/*.py
!/paper/_multi_ner_runs/*summary*
# Downloaded journal pages (bot-check HTML, not the guidelines themselves).
paper/publication/submission_readiness/journal_requirements_source/**/*.html
# Guard: full texts and PDFs must not be re-included by the release allow-rules above.
**/papers_txt/
**/pdfs/
# Pipeline working data under the post-2026-10-30 paths (the llm_terms/ rules above predate the move to
# pipelines/). Checkpoints, chunks and indexes hold section text of all papers; raw/metadata holds
# Entrez / Semantic Scholar records with abstracts. Code, configs, schemas and docs stay tracked.
/pipelines/corpus_v2/checkpoints/
/pipelines/corpus_v2/raw/
/pipelines/corpus_v2/releases/**/*
!/pipelines/corpus_v2/releases/**/
!/pipelines/corpus_v2/releases/**/README.md
!/pipelines/corpus_v2/releases/**/*.sha256
/pipelines/corpus_pipeline/chunks/
/pipelines/corpus_pipeline/index/
/pipelines/corpus_pipeline/manifests/
/pipelines/llm_terms/Output_final/*
!/pipelines/llm_terms/Output_final/scripts/
/pipelines/llm_terms/kg_builder/*checkpoint*.json
/src/notebooks/demo_output/
# Frozen validation: per-value check log (89 MB, pinned by FINAL_VALIDATION_MANIFEST.sha256; regenerate locally).
/paper/publication/final_validation/evidence_judge/deterministic_value_checks.jsonl

# --- External reference sources: provenance in, payload out ---
# `**/data/` above excludes the whole tree, so git never descends into it and a bare
# `!data/reference_kg/SOURCES.md` does NOT work (verified: exclusion of a directory
# disables all negations beneath it). Re-open each level explicitly, then drop the payload.
# Tracked: SOURCES.md + every SHA256SUMS / DOWNLOADED_AT (21 files, ~32 KB) — that is the
# download provenance the report cites. NOT tracked: the 769 MB of raw downloads, which are
# re-fetchable from the URLs in SOURCES.md and verified against these checksums.
# NOTE the leading slash: an unanchored `!data/` also matches pipelines/corpus_v2/data/,
# releases/*/data/ and src/scripts/data/, which re-exposed 600 MB of generated JSONL (verified).
!/data/
/data/*
!/data/reference_kg/
/data/reference_kg/*
!/data/reference_kg/SOURCES.md
!/data/reference_kg/raw/
/data/reference_kg/raw/*
!/data/reference_kg/raw/SHA256SUMS
!/data/reference_kg/raw/DOWNLOADED_AT
!/data/reference_kg/raw/*/
/data/reference_kg/raw/*/*
!/data/reference_kg/raw/*/SHA256SUMS
!/data/reference_kg/raw/*/DOWNLOADED_AT

# Terminology crosswalk tables (30.7 MB) are byte-identical to the checksummed copies
# inside releases/frozen_output/03_common_data_model/crosswalk/ (sha256 80267538…, 865c2c6c…)
# and regenerable by `python src/scripts/build_terminology_crosswalk.py` (OUT = docs/crosswalk).
# Keep the docs that explain them; drop the duplicated CSVs.
/docs/crosswalk/*.csv

# corpus_pipeline stage 08 report (2.3 MB, one row per chunk) — regenerated by stage08_chunk.py.
# The human-readable *.md summaries beside it stay tracked.
/pipelines/corpus_pipeline/reports/chunk_manifest.csv
