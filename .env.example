# ──────────────────────────────────────────────────────────────────────────────
# Example environment for the Microbiome CDM build pipeline.
#
# Copy to `.env` (which is .gitignored) and fill in your values. None of these
# secrets are required for the local SQLite / RDF build — only for the
# vocabulary-mapping steps that hit external APIs.
#
# Usage in shell:
#     set -a; source .env; set +a
# Or with python-dotenv:
#     from dotenv import load_dotenv; load_dotenv()
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
# Local Ollama daemon. Default port is 11434.
OLLAMA_HOST=http://127.0.0.1:11434
# Qwen model tag, must be available locally: `ollama pull qwen3.5:9b`
OLLAMA_MODEL=qwen3.5:9b
# Context and prediction length for batched Qwen calls.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512

# ── Embedding model (Ollama) ──────────────────────────────────────────────────
# Used for entity deduplication and Qwen-DB entity embeddings.
EMBED_MODEL=nomic-embed-text

# ── UMLS ──────────────────────────────────────────────────────────────────────
# Get a free key at https://uts.nlm.nih.gov/uts/edit-profile
UMLS_API_KEY=

# ── BioPortal ─────────────────────────────────────────────────────────────────
# Get a free key at https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=

# ── NCBI Entrez (PubMed, BioProject) ─────────────────────────────────────────
# Email is required by NCBI etiquette. API key raises rate limit.
ENTREZ_API_KEY=
ENTREZ_EMAIL=microbiome.cdm@example.com

# ── OMOP / OHDSI (optional) ───────────────────────────────────────────────────
# Athena vocabulary download URL. If unset, the OMOP mapping step is skipped.
ATHENA_VOCAB_URL=

# ── Build provenance ──────────────────────────────────────────────────────────
# Bump this when regenerating a release. Manifests include the build version.
CDM_BUILD_VERSION=2.1.0
# Random seed for reproducible stochastic components (embedding calls, etc.).
CDM_RANDOM_SEED=0