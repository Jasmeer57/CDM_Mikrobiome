{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microbiome-cdm.local/template/cdm/human_microbiome_cdm.schema.json",
  "title": "Human Microbiome Research CDM — entity registry",
  "description": "Machine-readable registry of CDM entities for the design phase. Registers each entity's layer, module, purpose, primary key, foreign keys, ID scheme, population sources, and inherited schema. Field-level definitions are inherited from the referenced schemas and NEVER duplicated here. Companion: human_microbiome_cdm_template.md (normative narrative), cdm_entity_registry.csv (flat view).",
  "type": "object",
  "required": [
    "schema_version",
    "released",
    "inherits",
    "entities"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "released": {
      "type": "string",
      "format": "date"
    },
    "inherits": {
      "type": "object",
      "description": "Existing artifacts this CDM template defers to for field-level definitions.",
      "properties": {
        "corpus_template": {
          "const": "template/corpus_template.json v1.1.0"
        },
        "data_catalogue_template": {
          "const": "template/data_catalogue/human_microbiome_data_catalogue.schema.json (Draft 2020-12)"
        },
        "cdm_catalogue_draft": {
          "const": "notebooks/cdm_catalogue_schema.yaml 0.1.0 DRAFT"
        },
        "corpus_v2_schemas": {
          "const": "corpus_v2/schema/*.json (paper, section, study, finding, processing_event, validation, triple)"
        },
        "termpipeline_ids": {
          "const": "scripts/termpipeline/ids.py (HMTERM_/HMOCC_/HMCTERM_/HMDEF_/HMMAP_)"
        },
        "canonical_config": {
          "const": "configs/canonical.yaml v2.1.1 (14 CDM entity types)"
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "entity",
        "module",
        "layer",
        "purpose",
        "primary_key",
        "population_sources",
        "inherits_fields_from",
        "status"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "description": "CDM entity name (UPPER_SNAKE)"
        },
        "module": {
          "type": "string",
          "enum": [
            "M1_source_documents",
            "M2_document_structure",
            "M3_processing",
            "M4_terminology",
            "M5_semantic_mappings",
            "M6_research_context",
            "M7_findings",
            "M8_evidence",
            "M9_quality_review",
            "M10_catalogue_releases"
          ]
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "0 = cross-layer"
        },
        "purpose": {
          "type": "string"
        },
        "primary_key": {
          "type": "string"
        },
        "primary_key_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "References as 'ENTITY.field'"
        },
        "identity_layer_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "population_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Existing files that populate it; 'PLANNED' if none yet"
        },
        "inherits_fields_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "POPULATED_EXISTING",
            "PARTIAL_POPULATED",
            "PLANNED",
            "PROVISIONAL"
          ]
        }
      }
    }
  },
  "entities": [
    {
      "entity": "PAPER",
      "module": "M1_source_documents",
      "layer": 1,
      "purpose": "One row per corpus paper: bibliographic identity, source integrity, eligibility, inclusion state.",
      "primary_key": "paper_id",
      "primary_key_pattern": "^HMPAPER_[0-9]{6}$",
      "foreign_keys": [],
      "population_sources": [
        "corpus_v2/data/papers.jsonl (453)",
        "data_catalogue/tables/papers.csv (453)"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/paper.schema.json",
        "template/corpus_template.json#document",
        "template/data_catalogue/csv_templates/papers.csv"
      ],
      "coverage_note": "453 papers, all with BioProject; duplicate_group_id/canonical_paper_id encode shared-publication duplicates.",
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "SOURCE_ASSET",
      "module": "M1_source_documents",
      "layer": 1,
      "purpose": "Original source files (txt/pdf/xml), raw payloads, hashes; never regenerated.",
      "primary_key": "source_file_id (path+hash composite)",
      "foreign_keys": [
        "PAPER.paper_id"
      ],
      "population_sources": [
        "corpus_v2/data/source_inventory.jsonl",
        "papers_txt/ (453)",
        "corpus_v2/raw/"
      ],
      "inherits_fields_from": [
        "corpus_v2/data/source_inventory.jsonl (fields)"
      ],
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "SECTION",
      "module": "M2_document_structure",
      "layer": 1,
      "purpose": "Section records; canonical evidence geometry. Offsets index section_text_original.",
      "primary_key": "(paper_id, section_id_original)",
      "foreign_keys": [
        "PAPER.paper_id"
      ],
      "population_sources": [
        "corpus_v2/data/sections.jsonl"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/section.schema.json"
      ],
      "coverage_note": "No section_id field; join on (paper_id, section_id_original). ~3.5k sections; section_text_cleaned is null.",
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "PARAGRAPH",
      "module": "M2_document_structure",
      "layer": 1,
      "purpose": "Paragraph units referenced by mentions (paragraph_id e.g. 'sec_gap_000:p0').",
      "primary_key": "paragraph_id (= section_id:pN)",
      "foreign_keys": [
        "SECTION.section_id"
      ],
      "population_sources": [
        "termpipeline term_mentions.paragraph_id (implicit)",
        "PLANNED: explicit table on ingest"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/assemble_mentions.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "SENTENCE",
      "module": "M2_document_structure",
      "layer": 1,
      "purpose": "Sentence units: evidence carriers for definitions and findings.",
      "primary_key": "sentence_id (= section_id:sN)",
      "foreign_keys": [
        "SECTION.section_id"
      ],
      "population_sources": [
        "termpipeline term_mentions.sentence_id",
        "term_definitions.sentence_id"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/assemble_mentions.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "EXTRACTION_RUN",
      "module": "M3_processing",
      "layer": 2,
      "purpose": "One row per pipeline execution (Slurm job / invocation): model, versions, prompt, coverage, elapsed, status. No CDM row exists without a run parent.",
      "primary_key": "extraction_run_id (Slurm job id or manifest id)",
      "foreign_keys": [],
      "population_sources": [
        "corpus_v2/data/processing_events.jsonl",
        "zenodo_v1 run summaries",
        "results/_termpipe_chain/terminology_extraction_manifest.json",
        "results/28608068_ner_eval_permodel/run_manifest.json (as inventory source)",
        "PLANNED: unified run inventory"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/processing_event.schema.json"
      ],
      "coverage_note": "Must include all discovered runs: zenodo_v1 section runs (7 CPU + Qwen), paper-level multi-NER, pubtator3 original (300 papers) + backfill (28608086), ollama comparisons, termpipeline chain + termpipe-v1, stage 53/54, llm-ner-body (28607825), cv-link (28607619). In-flight jobs enter PROVISIONAL.",
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "MODEL_RUN",
      "module": "M3_processing",
      "layer": 2,
      "purpose": "Model identity and version within a run (one per model×run); pinned versions from configs/canonical.yaml.",
      "primary_key": "model_run_id (run_id + model name)",
      "foreign_keys": [
        "EXTRACTION_RUN.extraction_run_id"
      ],
      "population_sources": [
        "run manifests and run-summary JSONs across zenodo_v1/, results/_termpipe_chain/, corpus_v2 stages"
      ],
      "inherits_fields_from": [
        "configs/canonical.yaml#environment"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "PROCESSING_LINEAGE",
      "module": "M3_processing",
      "layer": 2,
      "purpose": "Directed edges: run→input artifact, run→output artifact, run→derived run (e.g. section-level run derived from paper-level run of same model).",
      "primary_key": "(parent_id, child_id, relation)",
      "foreign_keys": [
        "EXTRACTION_RUN.extraction_run_id"
      ],
      "population_sources": [
        "corpus_v2/data/processing_events.jsonl (input/output hashes)",
        "PLANNED: explicit edges"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/processing_event.schema.json"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "TERM_MENTION",
      "module": "M4_terminology",
      "layer": 2,
      "purpose": "One extractor's tag of one span. Competing systems' tags of the same span stay separate rows.",
      "primary_key": "mention_id",
      "primary_key_pattern": "^HMTERM_[0-9a-f]{16}$",
      "foreign_keys": [
        "MODEL_RUN.model_run_id",
        "SECTION.section_id",
        "CANONICAL_TERM.term_id"
      ],
      "identity_layer_note": "mention_id hashes run_id — the layer that keeps models from merging.",
      "population_sources": [
        "results/_termpipe_chain/term_mentions.jsonl (SMOKE-CAPPED 2000 rows/source)",
        "zenodo_v1 CSVs (L2 originals preserved)",
        "PLANNED: termpipe-v1 full-scale"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/assemble_mentions.py"
      ],
      "coverage_note": "Full-scale mentions exist in zenodo_v1 CSVs; chain JSONL is smoke-capped pending termpipe-v1.",
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "TERM_OCCURRENCE",
      "module": "M4_terminology",
      "layer": 2,
      "purpose": "Extractor-independent occurrence of a span (HMOCC); lets models agree/disagree without merging.",
      "primary_key": "occurrence_key",
      "primary_key_pattern": "^HMOCC_[0-9a-f]{16}$",
      "foreign_keys": [
        "SECTION.section_id"
      ],
      "population_sources": [
        "results/_termpipe_chain/term_mentions.jsonl.occurrence_key"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/ids.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "CANONICAL_TERM",
      "module": "M4_terminology",
      "layer": 3,
      "purpose": "Deduplicated canonical term per (term_norm, cdm_type); carries observed counts, definition_status, taxonomy labels, review_status. Never a ground-truth assertion.",
      "primary_key": "term_id",
      "primary_key_pattern": "^HMCTERM_[0-9a-f]{16}$",
      "foreign_keys": [],
      "population_sources": [
        "results/_termpipe_chain/canonical_terms.jsonl (166,012)",
        "data/catalogue/terminology_dedup.csv (166,012)"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/build_canonical_terms.py"
      ],
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "TERM_DEFINITION",
      "module": "M4_terminology",
      "layer": 3,
      "purpose": "Source-grounded definition spans; SOURCE_DERIVED vs EXTERNAL never conflated.",
      "primary_key": "definition_id",
      "primary_key_pattern": "^HMDEF_[0-9a-f]{16}$",
      "foreign_keys": [
        "CANONICAL_TERM.term_id",
        "SECTION.section_id"
      ],
      "population_sources": [
        "results/_termpipe_chain/term_definitions.jsonl (SMOKE-CAPPED 30 papers)"
      ],
      "inherits_fields_from": [
        "scripts/termpipeline/extract_definitions.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "CONCEPT",
      "module": "M5_semantic_mappings",
      "layer": 4,
      "purpose": "Verified external vocabulary identifiers only (UMLS CUI, OMOP concept, NCBI taxon, MeSH) with source vocabulary. Never fabricated.",
      "primary_key": "(vocabulary, concept_code)",
      "foreign_keys": [],
      "population_sources": [
        "termpipeline term_ontology_mappings.jsonl (mappings only)",
        "cdm_output OMOP vocab tables (cdm_schema_alignment.py phase 2)"
      ],
      "inherits_fields_from": [
        "src/cdm_pipeline/cdm_schema_alignment.py (8 OMOP-style tables)"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "TERM_CONCEPT_MAP",
      "module": "M5_semantic_mappings",
      "layer": 4,
      "purpose": "Every mapping candidate per term with relation (EXACT/EQUIVALENT/BROADER/NARROWER/RELATED/UNRESOLVED/REJECTED) and disposition (ACCEPTED/CANDIDATE/REJECTED/UNRESOLVED/REVIEW_REQUIRED). Candidates retained alongside accepted.",
      "primary_key": "mapping_id",
      "primary_key_pattern": "^HMMAP_[0-9a-f]{16}$",
      "foreign_keys": [
        "CANONICAL_TERM.term_id",
        "CONCEPT.(vocabulary, concept_code)"
      ],
      "population_sources": [
        "results/_termpipe_chain/term_ontology_mappings.jsonl (chain, 20,000-term scope)",
        "results/_cv_link outputs when job 28607619 completes (36,475 terms, PROVISIONAL)"
      ],
      "inherits_fields_from": [
        "termpipeline term_ontology_mappings fields"
      ],
      "coverage_note": "chain scope smoke-capped; full cv-link run in flight.",
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "TAXONOMY_ANNOTATION",
      "module": "M5_semantic_mappings",
      "layer": 4,
      "purpose": "Binding of canonical terms to project term taxonomy (16 categories / 66 subcategories). Project labels, not external concepts.",
      "primary_key": "(term_id, taxonomy_version)",
      "foreign_keys": [
        "CANONICAL_TERM.term_id"
      ],
      "population_sources": [
        "data_catalogue/terminology/taxonomy/term_taxonomy_v1.{yaml,csv}",
        "canonical_terms.taxonomy_category/taxonomy_subcategory"
      ],
      "inherits_fields_from": [
        "data_catalogue terminology taxonomy v1"
      ],
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "STUDY",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Per-paper study context: design, population, methods, accessions; LLM provenance fields carried fully.",
      "primary_key": "study_id",
      "primary_key_pattern": "^HMPAPER_[0-9]{6}_STUDY_[0-9]{3}$",
      "foreign_keys": [
        "PAPER.paper_id"
      ],
      "population_sources": [
        "corpus_v2/data/studies.jsonl"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/study.schema.json"
      ],
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "COHORT",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Study populations as reported.",
      "primary_key": "cohort_id",
      "primary_key_pattern": "^HMCOHORT_[0-9]{6}$",
      "foreign_keys": [
        "PAPER.paper_id"
      ],
      "population_sources": [
        "data_catalogue/tables/cohorts.csv (9,501)"
      ],
      "inherits_fields_from": [
        "template/data_catalogue/csv_templates/cohorts.csv"
      ],
      "coverage_note": "Machine-extracted, UNVERIFIED — candidate for human curation (catalogue README).",
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "SAMPLE",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Sample groups / body sites (one row per reported group, not per specimen).",
      "primary_key": "sample_group_id",
      "primary_key_pattern": "^HMSAMPLE_[0-9]{6}$",
      "foreign_keys": [
        "PAPER.paper_id",
        "COHORT.cohort_id"
      ],
      "population_sources": [
        "data_catalogue/tables/samples.csv (8,421)"
      ],
      "inherits_fields_from": [
        "template/data_catalogue/csv_templates/samples.csv"
      ],
      "coverage_note": "sample_type normalization vocabulary: quality/sample_type_normalization.json; review queue in quality/sample_type_review_queue.csv.",
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "ASSAY",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Assays / sequencing workflows.",
      "primary_key": "assay_id",
      "primary_key_pattern": "^HMASSAY_[0-9]{6}$",
      "foreign_keys": [
        "PAPER.paper_id"
      ],
      "population_sources": [
        "data_catalogue/tables/assays.csv (12,060)"
      ],
      "inherits_fields_from": [
        "template/data_catalogue/csv_templates/assays.csv"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "BODY_SITE",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Normalized body-site labels; external concept link only if separately mapped.",
      "primary_key": "body_site_id (label key)",
      "foreign_keys": [],
      "population_sources": [
        "findings.body_site_original + planned normalization pass",
        "studies.body_sites"
      ],
      "inherits_fields_from": [
        "finding.schema.json#body_site_normalized",
        "findings body_site_original"
      ],
      "status": "PLANNED"
    },
    {
      "entity": "INTERVENTION",
      "module": "M6_research_context",
      "layer": 4,
      "purpose": "Exposures/interventions as reported in studies and findings.",
      "primary_key": "intervention_id (label key)",
      "foreign_keys": [
        "STUDY.study_id"
      ],
      "population_sources": [
        "studies.exposures_interventions",
        "findings.exposure_or_comparison"
      ],
      "inherits_fields_from": [
        "study.schema.json",
        "finding.schema.json"
      ],
      "status": "PLANNED"
    },
    {
      "entity": "CLAIM",
      "module": "M7_findings",
      "layer": 4,
      "purpose": "Extracted scientific findings (results, null results, interpretations) with quantitative fields; contradictory claims both retained.",
      "primary_key": "finding_id",
      "primary_key_pattern": "^HMPAPER_[0-9]{6}_FIND_[0-9]{4}$",
      "foreign_keys": [
        "PAPER.paper_id",
        "STUDY.study_id",
        "SECTION.section_id (evidence)"
      ],
      "population_sources": [
        "corpus_v2/data/findings.jsonl",
        "data_catalogue/tables/findings.csv (16,607)"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/finding.schema.json"
      ],
      "coverage_note": "Known quirk: ~1,088 p-value-shaped effect_estimate values (849 duplicating p_value, 239 sole) — documented, never silently corrected.",
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "RELATION",
      "module": "M7_findings",
      "layer": 4,
      "purpose": "Validated subject-predicate-object triples linked to canonical entities, retaining original triple + polarity/uncertainty.",
      "primary_key": "relation_id",
      "foreign_keys": [
        "CANONICAL_TERM.term_id (subject/object)",
        "EXTRACTION_RUN.extraction_run_id"
      ],
      "population_sources": [
        "PLANNED: stage 53/54 triple_mentions.jsonl (job 28607588 PENDING) + stage-56 canonicalize (28607924)",
        "prior validated triples in llm_terms outputs"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/triple_relation_schema.json",
        "triple_domains.json"
      ],
      "coverage_note": "Blocked on 28607588 (Resources). Leave-K-out suggests ~28% full-triple recovery — recorded as limitation.",
      "status": "PLANNED"
    },
    {
      "entity": "QUANTITATIVE_RESULT",
      "module": "M7_findings",
      "layer": 4,
      "purpose": "Numeric results (effect, CI, p, q, sample size) with reported statistics — never computed by us.",
      "primary_key": "quantitative_result_id",
      "foreign_keys": [
        "CLAIM.finding_id"
      ],
      "population_sources": [
        "findings effect_measure/effect_estimate/p_value/q_value/confidence_interval/sample_size fields"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/finding.schema.json"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "CLAIM_EVIDENCE",
      "module": "M8_evidence",
      "layer": 2,
      "purpose": "Evidence locator + quote + locator status for claims (auto gate), separate from verification (human gate).",
      "primary_key": "(finding_id, locator_type, locator)",
      "foreign_keys": [
        "CLAIM.finding_id",
        "SECTION.section_id"
      ],
      "population_sources": [
        "findings evidence fields (evidence_text, evidence_locator*, text_version_id)"
      ],
      "inherits_fields_from": [
        "corpus_v2/schema/finding.schema.json",
        "cdm_catalogue_schema.yaml rule 5 (quote==text[start:end])"
      ],
      "status": "POPULATED_EXISTING"
    },
    {
      "entity": "MENTION_EVIDENCE",
      "module": "M8_evidence",
      "layer": 2,
      "purpose": "Span-based evidence for mentions (offsets + supporting sentence context).",
      "primary_key": "(mention_id, text_version_id)",
      "foreign_keys": [
        "TERM_MENTION.mention_id",
        "SECTION.section_id"
      ],
      "population_sources": [
        "term_mentions start/end offsets + supporting_passage"
      ],
      "inherits_fields_from": [
        "termpipeline assemble_mentions.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "DEFINITION_EVIDENCE",
      "module": "M8_evidence",
      "layer": 2,
      "purpose": "Definition spans bound to their source passage.",
      "primary_key": "(definition_id, text_version_id)",
      "foreign_keys": [
        "TERM_DEFINITION.definition_id",
        "SECTION.section_id"
      ],
      "population_sources": [
        "term_definitions definition_text + char offsets"
      ],
      "inherits_fields_from": [
        "termpipeline extract_definitions.py"
      ],
      "status": "PARTIAL_POPULATED"
    },
    {
      "entity": "VALIDATION_RESULT",
      "module": "M9_quality_review",
      "layer": 5,
      "purpose": "Automated check outcomes: per-paper validation, span integrity, yields, catalogue integrity. Automated checks raise REVIEW_REQUIRED; they never resolve it.",
      "primary_key": "validation_result_id (check + target + run)",
      "foreign_keys": [
        "PAPER.paper_id",
        "EXTRACTION_RUN.extraction_run_id"
      ],
      "population_sources": [
        "corpus_v2/data/validation_per_paper.jsonl",
        "data_catalogue/quality/integrity_report.json",
