{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microbiome-cdm.local/corpus_v2/finding.schema.json",
  "title": "Corpus v2 finding record",
  "description": "One record per distinct scientific result (template 4), not one per paper. Null results, negative results and contradictory statements are findings too and are never silently dropped. The literal 'not_reported' means the source does not state a value - statistics are never invented. Human review is the verification gate: verification_status stays 'pending'; the automated quote check lives in evidence_locator_status.",
  "type": "object",
  "required": [
    "finding_id", "corpus_id", "study_id", "paper_id", "evidence_section_id",
    "claim_type", "body_site_original", "population_subgroup",
    "exposure_or_comparison", "outcome", "taxon_original", "taxonomic_rank",
    "microbial_function_pathway", "direction", "direction_refers_to",
    "effect_measure", "effect_estimate", "p_value", "q_value",
    "confidence_interval", "adjusted_covariates", "sample_size",
    "evidence_text", "evidence_locator_type", "text_version_id",
    "extraction_method", "extractor_model_and_version",
    "extractor_prompt_version", "verification_status",
    "extraction_status_section", "llm_source_section_status"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^HMPAPER_[0-9]{6}_FIND_[0-9]{4}$"},
    "corpus_id": {"type": "string", "pattern": "^HMPAPER_[0-9]{6}$"},
    "study_id": {"type": "string", "pattern": "^HMPAPER_[0-9]{6}_STUDY_[0-9]{3}$"},
    "paper_id": {"type": "string", "pattern": "^HMPAPER_[0-9]{6}$"},
    "claim_type": {"enum": ["result", "null_result", "author_interpretation", "other"]},
    "body_site_original": {"type": "string"},
    "body_site_normalized": {"type": ["string", "null"], "description": "Filled by a later normalization pass, if any."},
    "population_subgroup": {"type": "string"},
    "exposure_or_comparison": {"type": "string"},
    "outcome": {"type": "string"},
    "taxon_original": {"type": "string"},
    "taxon_normalized": {"type": ["string", "null"]},
    "taxonomic_rank": {"enum": ["strain", "species", "genus", "family", "order",
                                 "class", "phylum", "domain", "clade", "unknown"]},
    "microbial_function_pathway": {"type": "string"},
    "direction": {"enum": ["increased", "decreased", "no_association_reported",
                            "mixed", "unclear"]},
    "direction_refers_to": {"type": "string"},
    "effect_measure": {"type": "string"},
    "effect_estimate": {"type": "string"},
    "p_value": {"type": "string"},
    "q_value": {"type": "string"},
    "confidence_interval": {"type": "string"},
    "adjusted_covariates": {"type": "string"},
    "sample_size": {"type": "string"},
    "evidence_text": {"type": "string", "description": "Verbatim quote (whitespace-collapsed) from the cited text version; verified by stage 55."},
    "evidence_section_id": {"type": "string"},
    "evidence_locator_type": {"enum": ["section"]},
    "evidence_locator": {"type": "string", "description": "section:<section_record_id>#chars=<start>-<end> after stage 55; offsets are chars on section_text_original. Unresolved quotes still carry the section id."},
    "evidence_locator_convention": {"type": ["string", "null"]},
    "evidence_locator_chars": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "text_version_id": {"type": ["string", "null"], "description": "sha256 of section_text_original; the text version the quote must be recoverable from."},
    "extraction_method": {"enum": ["manual", "automated", "hybrid"]},
    "extractor_model_and_version": {"type": "string"},
    "extractor_prompt_version": {"type": "string"},
    "confidence_scale_and_value": {"type": ["string", "null"]},
    "verification_status": {"enum": ["pending", "verified", "rejected", "needs_revision"]},
    "evidence_locator_status": {"enum": ["verified_exact", "verified_normalized", "unresolved_not_in_source"], "description": "Automated quote check by stage 55."},
    "reviewer": {"type": ["string", "null"]},
    "review_date": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "chunk": {"type": "integer"},
    "chunk_char_offset": {"type": "integer"},
    "extraction_status_section": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "llm_source_section_status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]}
  },
  "additionalProperties": true
}
